<form>
    <group string="Settings" id="dhis_data_mapping_settings_group">
        <label name="name"/>
        <field name="name"/>
        <label name="mapping_active"/>
        <field name="mapping_active"/>
        <newline/>
        <label name="data_element"/>
        <field name="data_element"/>
        <label name="category_option"/>
        <field name="category_option"/>
    </group>
    <newline/>
    <group string="Query Information" id="dhis_data_mapping_query_group">
        <label name="data_time"/>
        <field name="data_time" widget="datetime"/>
        <newline/>
        <label name="data_submitted_at"/>
        <field name="data_submitted_at" widget="datetime"/>
        <newline/>
        <label name="data"/>
        <field name="data" widget="text"/>
        <newline/>
        <label name="sql_query"/>
        <field name="sql_query" widget="text"/>
    </group>
</form>