<tryton>
    <data>
        <!-- Orthanc icon -->
        <record model="ir.ui.icon" id="orthanc_icon">
            <field name="name">orthanc</field>
            <field name="path">icons/orthanc_logo.svg</field>
        </record>
        <record model="ir.ui.icon" id="excute_icon">
            <field name="name">execute</field>
            <field name="path">icons/execute_icon.svg</field>
        </record>

        <!-- Orthanc config  -->
        <record model="ir.ui.view" id="orthanc_view_config_tree">
            <field name="model">gnuhealth.imaging_orthanc.server_config</field>
            <field name="type">tree</field>
            <field name="name">orthanc_config_tree</field>
        </record>
        <record model="ir.ui.view" id="orthanc_view_config_form">
            <field name="model">gnuhealth.imaging_orthanc.server_config</field>
            <field name="type">form</field>
            <field name="name">orthanc_config_form</field>
        </record>
        
        <!-- Orthanc config menu -->
        <menuitem name="Orthanc"
                  sequence="20"
                  parent="health_imaging.menu_imaging_test_parent"
                  id="imaging_orthanc_config_menu"
                  icon="orthanc"/>

        <record model="ir.action.act_window" id="act_orthanc_server_view">
            <field name="name">Servers</field>
            <field name="res_model">gnuhealth.imaging_orthanc.server_config</field>
        </record>

        <menuitem name="Servers" sequence="20" parent="imaging_orthanc_config_menu" action="act_orthanc_server_view" id="orthanc_servers_menu" icon="gnuhealth-list"/>
           
        <!-- Wizard and Views to add server -->
        <record model="ir.ui.view" id="view_orthanc_add_init_data">
            <field name="model">gnuhealth.imaging_orthanc.orthanc_add_init_data</field>
            <field name="type">form</field>
            <field name="name">add_orthanc_server_init_data</field>
        </record>

        <record model="ir.ui.view" id="view_orthanc_add_status">
            <field name="model">gnuhealth.imaging_orthanc.add.status</field>
            <field name="type">form</field>
            <field name="name">add_orthanc_server_status</field>
        </record>
        
        <record model="ir.action.wizard" id="orthanc_add_server_init_data">
            <field name="name">Add New Server</field>
            <field name="wiz_name">gnuhealth.imaging_orthanc.wizard.orthanc_new_connect</field>
        </record>
        <menuitem parent="imaging_orthanc_config_menu" action="orthanc_add_server_init_data" id="imaging_orthanc_add_server_menu" sequence="10" icon="execute"/>
    </data>
</tryton>
