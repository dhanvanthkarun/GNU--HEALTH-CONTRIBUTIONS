<tryton>
    <data>
        <record model="ir.action.wizard" id="act_full_synchronize">
         <field name="name">Full Synchronize</field>
         <field name="wiz_name">gnuhealth.imaging.fullSynchronize</field>
         <field name="model">gnuhealth.imaging.imagingStudy</field>
        </record>

        <record model="ir.action.keyword" id="full_synchronize_keyword">
           <field name="keyword">form_action</field>
           <field name="model">gnuhealth.imaging.imagingStudy,-1</field>
           <field name="action" ref="act_full_synchronize"/>
        </record>

        <record model="ir.ui.view" id="full_synchronize_start_form">
         <field name="model">gnuhealth.imaging.fullSynchronize.start</field>
         <field name="type">form</field>
         <field name="name">full_synchronize_start_form</field>
        </record>

    </data>
</tryton>