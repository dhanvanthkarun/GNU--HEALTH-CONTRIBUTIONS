<form>
    <notebook>
        <page string = 'Study Content' id='imagingstudy_content_page'>
            <group colspan="3" id="gnuhealth_info">
                <label name="patient"/>
                <field name="patient" colspan="1"/>
            </group>
            <newline/>
            <group colspan="4" col="6" id="imagingStudy_info">
                <label name="date"/>
                <field name="date"/>
                <label name="institution"/>
                <field name="institution"/>
                <label name="performingPhysicianName"/>
                <field name="performingPhysicianName"/>
            </group>
            <newline/>
            <group colspan="4" id="study_series_group" yexpand="1">
                <field colspan="5" name="series"/>
            </group>    
            <newline/>
            <group string="Study Notes" colspan="4" id="imaging_study_notes">
                <field name="notes" colspan="4"/>
            </group>
        </page>
     </notebook>
</form>