            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>


<!-- END OF DEFAULT ACCESS RIGHTS -->

<!-- Create the Health radiology group -->
        <record model="res.group" id="group_radiology">
            <field name="name">Health Radiology</field>
        </record>

<!-- Create the Health radiology Administration group -->
        <record model="res.group" id="group_radiology_admin">
            <field name="name">Health Radiology Administration</field>
        </record>

<!-- BEGIN radiology ADMINISTRATION GROUP ACCESS RIGHTS -->

<!-- Assign the Group to the "admin" user -->
        <record model="res.user-res.group" id="group_radiology_user_admin">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_radiology_admin"/>
        </record>

<!-- Access to Menus -->
        <record model="ir.ui.menu-res.group" id="group_radiology_menu_admin">
