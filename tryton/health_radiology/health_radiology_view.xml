<tryton>
    <data>
        <!-- Icons-->

        <record model="ir.ui.icon" id="radiology_icon">
            <field name="name">gnuhealth.radiology</field>
            <field name="path">icons/radiology_icon.svg</field>
        </record>
        <record model="ir.ui.icon" id="orthanc_icon">
            <field name="name">orthanc</field>
            <field name="path">icons/orthanc_logo.svg</field>
        </record>
        <!-- <record model="ir.ui.icon" id="delete_icon">
            <field name="name">delete</field>
            <field name="path">icons/delete.svg</field>
        </record> -->
        
        <!-- Parent menu item -->

        <menuitem name="Radiology" parent="health.gnuhealth_menu"
            id="menu_radiology_parent" icon="gnuhealth.radiology"/>

        <!-- Views -->

        <!-- Add Studies to Imaging Result Form -->
        <record model="ir.ui.view" id="view_radiology_imaging_test_result_form">
            <field name="model">gnuhealth.imaging.test.result</field>
            <field name="inherit" ref="health_imaging.view_imaging_test_result_form"/>
            <field name="name">imaging_form</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_patient_form">
            <field name="model">gnuhealth.patient</field>
            <field name="type">form</field>
            <field name="name">radiology_patient_form</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_patient_tree">
            <field name="model">gnuhealth.patient</field>
            <field name="type">tree</field>
            <field name="name">radiology_patient_tree</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_study_form">
            <field name="model">gnuhealth.radiology.study</field>
            <field name="type">form</field>
            <field name="name">radiology_study_form</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_study_tree">
            <field name="model">gnuhealth.radiology.study</field>
            <field name="type">tree</field>
            <field name="name">radiology_study_tree</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_study_series_form">
            <field name="model">gnuhealth.radiology.study_series</field>
            <field name="type">form</field>
            <field name="name">radiology_study_series_form</field>
        </record>
        
        <record model="ir.ui.view" id="view_radiology_study_series_tree">
            <field name="model">gnuhealth.radiology.study_series</field>
            <field name="type">tree</field>
            <field name="name">radiology_study_series_tree</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_series_instances_form">
            <field name="model">gnuhealth.radiology.series_instances</field>
            <field name="type">form</field>
            <field name="name">radiology_series_instances_form</field>
        </record>

        <record model="ir.ui.view" id="view_radiology_series_instances_tree">
            <field name="model">gnuhealth.radiology.series_instances</field>
            <field name="type">tree</field>
            <field name="name">radiology_series_instances_tree</field>
        </record>

        
        <!-- Act_Windows -->

        <record model="ir.action.act_window" id="act_radiology_patient_view">
            <field name="name">Patients</field>
            <field name="res_model">gnuhealth.patient</field>
        </record>

        <record model="ir.action.act_window" id="act_radiology_study_view">
            <field name="name">Studies</field>
            <field name="res_model">gnuhealth.radiology.study</field>
        </record>

        <record model="ir.action.act_window" id="act_radiology_study_series_view">
            <field name="name">Series</field>
            <field name="res_model">gnuhealth.radiology.study_series</field>
        </record>

        <!-- Window views -->

        <record model="ir.action.act_window.view" id="act_radiology_patient_tree_view">
            <field name="sequence" eval="30"/>
            <field name="view" ref="view_radiology_patient_tree"/>
            <field name="act_window" ref="act_radiology_patient_view"/>
        </record>
      
        <record model="ir.action.act_window.view" id="act_radiology_patient_form_view">
            <field name="sequence" eval="40"/>
            <field name="view" ref="view_radiology_patient_form"/>
            <field name="act_window" ref="act_radiology_patient_view"/>
        </record>

        <record model="ir.action.act_window.view" id="act_radiology_study_tree_view">
            <field name="sequence" eval="50"/>
            <field name="view" ref="view_radiology_study_tree"/>
            <field name="act_window" ref="act_radiology_study_view"/>
        </record>

        <record model="ir.action.act_window.view" id="act_radiology_study_form_view">
            <field name="sequence" eval="60"/>
            <field name="view" ref="view_radiology_study_form"/>
            <field name="act_window" ref="act_radiology_study_view"/>
        </record>
        
        <!-- Menu items -->
        <menuitem parent="menu_radiology_parent" action="act_radiology_patient_view" 
            id="orthanc_menu_patient_view" icon="gnuhealth-patient" sequence= "10"/>

        <menuitem parent="menu_radiology_parent" action="act_radiology_study_view" 
            id="orthanc_menu_study_view" icon="orthanc" sequence= "20"/>        
    </data>
</tryton>
