<form>
    <group id="or_shcedule_header" colspan="4" col="8">
        <label name="name" string="Op. Room"/>
        <field name="name"/>
        <group id="or_sched_period">
            <label name="reserve_from"/>
            <field name="reserve_from"/>
            <label name="reserve_to"/>
            <field name="reserve_to"/>
        </group>
        <label name="surgery"/>
        <field name="surgery"/>        
    </group>
    <group id="or_schedule_details">
        <label name="healthprof"/>
        <field name="healthprof"/>
        <label name="patient"/>
        <field name="patient"/>
        <newline/>
        <label name="specialty"/>
        <field name="specialty"/>
        <label name="urgency"/>
        <field name="urgency"/>
    </group>
    <newline/>
    <separator id="or_schedule_remarks" string="Remarks" colspan="4"/>
    <newline/>
    <field name="comments" colspan="4"/>
    <group id="or_shcedule_footer" colspan="4" col="2">
        <label name="institution"/>
        <field name="institution"/>
    </group>
</form>
