msgctxt "model:gnuhealth.pathology.category,name:icdcat9-8"
msgid "(I70-I79) Diseases of arteries, arterioles and capillaries"
msgstr "(I70-I79) Ασθένειες των αρτηριών, των αρτηριδίων και των τριχοειδών"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-9"
msgid ""
"(I80-I89) Diseases of veins, lymphatic vessels and lymph nodes, not "
"elsewhere classified"
msgstr ""
"(I80-I89) Ασθένειες των φλεβών, των λεμφαγγείων και των λεμφαδένων, που δεν "
"ταξινομούνται αλλού"

msgctxt "model:gnuhealth.pathology.category,name:icdcat_root"
msgid "ICD-10"
msgstr "ICD-10"
