msgstr "(I05-I09) Χρόνιες ρευματικές καρδιοπάθειες"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-3"
msgid "(I10-I15) Hypertensive diseases"
msgstr "(I10-I15) Υπερτασικές νόσοι"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-4"
msgid "(I20-I25) Ischaemic heart diseases"
msgstr "(I20-I25) Ισχαιμικές καρδιοπάθειες"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-5"
msgid ""
"(I26-I28) Pulmonary heart disease and diseases of pulmonary circulation"
msgstr ""
"(I26-I28) Πνευμονική καρδιοπάθεια και ασθένειες της πνευμονικής κυκλοφορίας"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-6"
msgid "(I30-I52) Other forms of heart disease"
msgstr "(I30-I52) Άλλες μορφές καρδιοπάθειας"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-7"
msgid "(I60-I69) Cerebrovascular diseases"
