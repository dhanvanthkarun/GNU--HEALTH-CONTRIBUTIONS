msgstr "VI Ασθένειες του νευρικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-1"
msgid "(G00-G09) Inflammatory diseases of the central nervous system"
msgstr "(G00-G09) Φλεγμονώδεις ασθένειες του κεντρικού νευρικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-10"
msgid "(G80-G83) Cerebral palsy and other paralytic syndromes"
msgstr "(G80-G83) Εγκεφαλική παράλυση και άλλα παραλυτικά σύνδρομα"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-11"
msgid "(G90-G99) Other disorders of the nervous system"
msgstr "(G90-G99) Άλλες διαταραχές του νευρικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-2"
msgid ""
"(G10-G14) Systemic atrophies primarily affecting the central nervous system"
msgstr ""
"(G10-G14) Συστηματικές ατροφίες που επηρεάζουν πρωτίστως το κεντρικό νευρικό"
" σύστημα"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-3"
msgid "(G20-G26) Extrapyramidal and movement disorders"
msgstr "(G20-G26) Εξωπυραμιδικές και κινητικές διαταραχές"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-4"
msgid "(G30-G32) Other degenerative diseases of the central nervous system"
msgstr ""
"(G30-G32) Άλλες εκφυλιστικές ασθένειες του κεντρικού νευρικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-5"
msgid "(G35-G37) Demyelinating diseases of the central nervous system"
msgstr "(G35-G37) Απομυελινωτικές ασθένειες του κεντρικού νευρικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-6"
msgid "(G40-G47) Episodic and paroxysmal disorders"
msgstr "(G40-G47) Επεισοδιακές και παροξυσμικές διαταραχές"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-7"
msgid "(G50-G59) Nerve, nerve root and plexus disorders"
msgstr "(G50-G59) Διαταραχές νεύρων, νευρικών ριζών και πλεγμάτων"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-8"
msgid ""
"(G60-G64) Polyneuropathies and other disorders of the peripheral nervous "
"system"
msgstr ""
"(G60-G64) Πολυνευροπάθειες και άλλες διαταραχές του περιφερικού νευρικού "
"συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat6-9"
msgid "(G70-G73) Diseases of myoneural junction and muscle"
msgstr "(G70-G73) Ασθένειες της νευρομυϊκής σύναψης και των μυών"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7"
msgid "VII Diseases of the eye and adnexa"
msgstr "VII Ασθένειες του οφθαλμού και των εξαρτημάτων του"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-1"
msgid "(H00-H06) Disorders of eyelid"
msgstr ""
"(H00-H06) Διαταραχές του βλεφάρου, της δακρυϊκής συσκευής και του κόγχου"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-10"
msgid "(H53-H54) Visual disturbances and blindness"
msgstr "(H53-H54) Οπτικές διαταραχές και τύφλωση"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-11"
msgid "(H55-H59) Other disorders of eye and adnexa"
msgstr "(H55-H59) Άλλες διαταραχές του οφθαλμού και των εξαρτημάτων του"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-2"
msgid "(H10-H13) Disorders of conjunctiva"
msgstr "(H10-H13) Διαταραχές του επιπεφυκότα"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-3"
msgid "(H15-H22) Disorders of sclera, cornea, iris and ciliary body"
msgstr ""
"(H15-H22) Διαταραχές του σκληρού χιτώνα, του κερατοειδούς, της ίριδας και "
"του ακτινωτού σώματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-4"
msgid "(H25-H28) Disorders of lens"
msgstr "(H25-H28) Διαταραχές του φακού"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-5"
msgid "(H30-H36) Disorders of choroid and retina"
msgstr "(H30-H36) Διαταραχές του χοριοειδούς και του αμφιβληστροειδούς"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-6"
msgid "(H40-H42) Glaucoma"
msgstr "(H40-H42) Γλαύκωμα"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-7"
msgid "(H43-H45) Disorders of vitreous body and globe"
msgstr "(H43-H45) Διαταραχές του υαλοειδούς σώματος και του βολβού"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-8"
msgid "(H46-H48) Disorders of optic nerve and visual pathways"
msgstr "(H46-H48) Διαταραχές του οπτικού νεύρου και των οπτικών οδών"

msgctxt "model:gnuhealth.pathology.category,name:icdcat7-9"
msgid ""
"(H49-H52) Disorders of ocular muscles, binocular movement, accommodation and"
" refraction"
msgstr ""
"(H49-H52) Διαταραχές των οφθαλμικών μυών, της διόφθαλμης κίνησης, της "
"προσαρμογής και της διάθλασης"

msgctxt "model:gnuhealth.pathology.category,name:icdcat8"
msgid "VIII Diseases of the ear and mastoid process"
msgstr "VIII Ασθένειες του αυτιού και της μαστοειδούς απόφυσης"

msgctxt "model:gnuhealth.pathology.category,name:icdcat8-1"
msgid "(H60-H62) Diseases of external ear"
msgstr "(H60-H62) Ασθένειες του έξω αυτιού"

msgctxt "model:gnuhealth.pathology.category,name:icdcat8-2"
msgid "(H65-H75) Diseases of middle ear and mastoid"
msgstr "(H65-H75) Ασθένειες του μέσου αυτιού και της μαστοειδούς"

msgctxt "model:gnuhealth.pathology.category,name:icdcat8-3"
msgid "(H80-H83) Diseases of inner ear"
msgstr "(H80-H83) Ασθένειες του έσω αυτιού"

msgctxt "model:gnuhealth.pathology.category,name:icdcat8-4"
msgid "(H90-H95) Other disorders of ear"
msgstr "(H90-H95) Άλλες διαταραχές του αυτιού"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9"
msgid "IX Diseases of the circulatory system"
msgstr "IX Ασθένειες του κυκλοφορικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-1"
msgid "(I00-I02) Acute rheumatic fever"
msgstr "(I00-I02) Οξύς ρευματικός πυρετός"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-10"
msgid "(I95-I99) Other and unspecified disorders of the circulatory system"
msgstr ""
"(I95-I99) Άλλες και μη καθορισμένες διαταραχές του κυκλοφορικού συστήματος"

msgctxt "model:gnuhealth.pathology.category,name:icdcat9-2"
