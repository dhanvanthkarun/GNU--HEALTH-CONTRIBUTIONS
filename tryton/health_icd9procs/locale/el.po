msgid "Procedure on vessel bifurcation"
msgstr "Επέμβαση σε διχασμό αγγείου"

msgctxt "model:gnuhealth.procedure,description:cie9_00-45"
msgid "Insertion of one vascular stent"
msgstr "Τοποθέτηση ενός αγγειακού στεντ"

msgctxt "model:gnuhealth.procedure,description:cie9_00-46"
msgid "Insertion of two vascular stents"
msgstr "Τοποθέτηση δύο αγγειακών στεντ"

msgctxt "model:gnuhealth.procedure,description:cie9_00-47"
msgid "Insertion of three vascular stents"
msgstr "Τοποθέτηση τριών αγγειακών στεντ"

