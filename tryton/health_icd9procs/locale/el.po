msgid "Infusion of vasopressor agent"
msgstr "Έγχυση αγγειοσυσπαστικού παράγοντα"

msgctxt "model:gnuhealth.procedure,description:cie9_00-18"
msgid "Infusion of immunosuppressive antibody therapy"
msgstr "Έγχυση θεραπείας ανοσοκατασταλτικών αντισωμάτων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-19"
msgid "Disruption of blood brain barrier via infusion [BBBD]"
msgstr "Διάσπαση του αιματοεγκεφαλικού φραγμού μέσω έγχυσης [BBBD]"

msgctxt "model:gnuhealth.procedure,description:cie9_00-21"
msgid "Intravascular imaging of extracranial cerebral vessels"
msgstr "Ενδαγγειακή απεικόνιση εξωκρανιακών εγκεφαλικών αγγείων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-22"
msgid "Intravascular imaging of intrathoracic vessels"
msgstr "Ενδαγγειακή απεικόνιση ενδοθωρακικών αγγείων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-23"
msgid "Intravascular imaging of peripheral vessels"
msgstr "Ενδαγγειακή απεικόνιση περιφερικών αγγείων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-24"
msgid "Intravascular imaging of coronary vessels"
msgstr "Ενδαγγειακή απεικόνιση στεφανιαίων αγγείων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-25"
msgid "Intravascular imaging of renal vessels"
msgstr "Ενδαγγειακή απεικόνιση νεφρικών αγγείων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-28"
msgid "Intravascular imaging, other specified vessel(s)"
msgstr "Ενδαγγειακή απεικόνιση, άλλα καθορισμένα αγγεία"

msgctxt "model:gnuhealth.procedure,description:cie9_00-29"
msgid "Intravascular imaging, unspecified vessel(s)"
msgstr "Ενδαγγειακή απεικόνιση, μη καθορισμένα αγγεία"

msgctxt "model:gnuhealth.procedure,description:cie9_00-31"
msgid "Computer assisted surgery with CT/CTA"
msgstr "Χειρουργική με υποβοήθηση υπολογιστή με CT/CTA"

msgctxt "model:gnuhealth.procedure,description:cie9_00-32"
msgid "Computer assisted surgery with MR/MRA"
msgstr "Χειρουργική με υποβοήθηση υπολογιστή με MR/MRA"

msgctxt "model:gnuhealth.procedure,description:cie9_00-33"
msgid "Computer assisted surgery with fluoroscopy"
msgstr "Χειρουργική με υποβοήθηση υπολογιστή με ακτινοσκόπηση"

msgctxt "model:gnuhealth.procedure,description:cie9_00-34"
msgid "Imageless computer assisted surgery"
msgstr "Χειρουργική με υποβοήθηση υπολογιστή χωρίς απεικόνιση"

msgctxt "model:gnuhealth.procedure,description:cie9_00-35"
