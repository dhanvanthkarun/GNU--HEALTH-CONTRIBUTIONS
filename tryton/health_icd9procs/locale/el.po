msgctxt "model:gnuhealth.procedure,description:cie9_00-13"
msgid "Injection or infusion of nesiritide"
msgstr "Ένεση ή έγχυση νεσιριτίδης"

msgctxt "model:gnuhealth.procedure,description:cie9_00-14"
msgid "Injection or infusion of oxazolidinone class of antibiotics"
msgstr "Ένεση ή έγχυση αντιβιοτικών της κατηγορίας των οξαζολιδινονών"

msgctxt "model:gnuhealth.procedure,description:cie9_00-15"
msgid "High-dose infusion interleukin-2 [IL-2]"
msgstr "Έγχυση υψηλής δόσης ιντερλευκίνης-2 [IL-2]"

msgctxt "model:gnuhealth.procedure,description:cie9_00-16"
msgid ""
"Pressurized treatment of venous bypass graft [conduit] with pharmaceutical "
"substance"
msgstr ""
"Θεραπεία υπό πίεση φλεβικού μοσχεύματος παράκαμψης [αγωγού] με φαρμακευτική "
"ουσία"

