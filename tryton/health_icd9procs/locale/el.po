msgctxt "model:gnuhealth.procedure,description:cie9_00-65"
msgid "Percutaneous insertion of intracranial vascular stent(s)"
msgstr "Διαδερμική τοποθέτηση ενδοκρανιακών αγγειακών στεντ(ς)"

msgctxt "model:gnuhealth.procedure,description:cie9_00-66"
