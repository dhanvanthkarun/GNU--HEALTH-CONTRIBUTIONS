msgctxt "model:gnuhealth.procedure,description:cie9_00-01"
msgid "Therapeutic ultrasound of vessels of head and neck"
msgstr "Θεραπευτικός υπέρηχος των αγγείων της κεφαλής και του τραχήλου"

msgctxt "model:gnuhealth.procedure,description:cie9_00-02"
msgid "Therapeutic ultrasound of heart"
msgstr "Θεραπευτικός υπέρηχος καρδιάς"

msgctxt "model:gnuhealth.procedure,description:cie9_00-03"
msgid "Therapeutic ultrasound of peripheral vascular vessels"
msgstr "Θεραπευτικός υπέρηχος των περιφερικών αγγείων"

msgctxt "model:gnuhealth.procedure,description:cie9_00-09"
msgid "Other therapeutic ultrasound"
msgstr "Άλλος θεραπευτικός υπέρηχος"

msgctxt "model:gnuhealth.procedure,description:cie9_00-10"
msgid "Implantation of chemotherapeutic agent"
msgstr "Εμφύτευση χημειοθεραπευτικού παράγοντα"

msgctxt "model:gnuhealth.procedure,description:cie9_00-11"
msgid "Infusion of drotrecogin alfa (activated)"
