msgctxt "model:gnuhealth.procedure,description:cie9_00-39"
msgid "Other computer assisted surgery"
msgstr "Άλλη χειρουργική με υποβοήθηση υπολογιστή"

msgctxt "model:gnuhealth.procedure,description:cie9_00-40"
msgid "Procedure on single vessel"
msgstr "Επέμβαση σε ένα αγγείο"

msgctxt "model:gnuhealth.procedure,description:cie9_00-41"
msgid "Procedure on two vessels"
msgstr "Επέμβαση σε δύο αγγεία"

msgctxt "model:gnuhealth.procedure,description:cie9_00-42"
msgid "Procedure on three vessels"
msgstr "Επέμβαση σε τρία αγγεία"

msgctxt "model:gnuhealth.procedure,description:cie9_00-43"
msgid "Procedure on four or more vessels"
msgstr "Επέμβαση σε τέσσερα ή περισσότερα αγγεία"

