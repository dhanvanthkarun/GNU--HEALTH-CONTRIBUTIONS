msgctxt "model:gnuhealth.procedure,description:cie9_00-67"
msgid "Intravascular pressure measurement of intrathoracic arteries"
msgstr "Μέτρηση ενδαγγειακής πίεσης ενδοθωρακικών αρτηριών"

msgctxt "model:gnuhealth.procedure,description:cie9_00-68"
msgid "Intravascular pressure measurement of peripheral arteries"
msgstr "Μέτρηση ενδαγγειακής πίεσης περιφερικών αρτηριών"

msgctxt "model:gnuhealth.procedure,description:cie9_00-69"
msgid ""
"Intravascular pressure measurement, other specified and unspecified vessels"
msgstr "Μέτρηση ενδαγγειακής πίεσης, άλλα καθορισμένα και μη καθορισμένα αγγεία"

msgctxt "model:gnuhealth.procedure,description:cie9_00-70"
