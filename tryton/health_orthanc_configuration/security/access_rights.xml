<!-- Default template for permission groups -->

<tryton>
    <data>

<!-- Default access rights to models -->
        <record model="ir.model.access" id="access_health_orthanc_configServer">
            <field name="model" search="[('model', '=', 'gnuhealth.orthanc.configServer')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="True"/>
        </record>

<!-- END OF DEFAULT ACCESS RIGHTS -->

<!-- Create the Health orthanc configuration group -->
        <record model="res.group" id="group_health_orthanc_config">
            <field name="name">Health Orthanc Configuration</field>
        </record>

<!-- Create the Health orthanc configuration group -->
        <record model="res.group" id="group_health_orthanc_config_admin">
            <field name="name">Health Orthanc Configuration Administration</field>
        </record>

<!-- BEGIN imaging ADMINISTRATION GROUP ACCESS RIGHTS -->

<!-- Assign the Group to the "admin" user -->
        <record model="res.user-res.group" id="user_admin_group_orthanc_config">
            <field name="user" ref="res.user_admin"/>
            <field name="group" ref="group_health_orthanc_config_admin"/>
        </record>

<!-- Access to Menus -->
        <!-- <record model="ir.ui.menu-res.group" id="menu_health_group_health_radiology_admin">
            <field name="menu" ref="menu_radiology_parent"/>
            <field name="group" ref="group_health_radiology_admin"/>
        </record> -->

<!-- Access rights to models for the health admin group -->
        <record model="ir.model.access" id="access_orthanc_config_admin">
            <field name="model" search="[('model', '=', 'gnuhealth.orthanc.configServer')]"/>
            <field name="group" ref="group_health_orthanc_config_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="True"/>
        </record>

<!-- END imaging ADMINISTRATION GROUP ACCESS RIGHTS -->

<!-- BEGIN USER GROUP ACCESS RIGHTS -->

