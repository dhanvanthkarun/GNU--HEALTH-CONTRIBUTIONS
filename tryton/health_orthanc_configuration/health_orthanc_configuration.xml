<tryton>
    <data>
        <!-- Orthanc icon -->
        <record model="ir.ui.icon" id="orthanc_icon">
            <field name="name">orthanc</field>
            <field name="path">icons/orthanc_logo.svg</field>
        </record>
        
        <!-- Orthanc config  -->
        <record model="ir.ui.view" id="orthanc_view_config_tree">
            <field name="model">gnuhealth.orthanc.configServer</field>
            <field name="type">tree</field>
            <field name="name">orthanc_config_tree</field>
        </record>
        <record model="ir.ui.view" id="orthanc_view_config_form">
            <field name="model">gnuhealth.orthanc.configServer</field>
            <field name="type">form</field>
            <field name="name">orthanc_config_form</field>
        </record>
        
        <!-- Orthanc config menu -->
        <menuitem name="Orthanc_Config" parent="health.gnuhealth_conf_menu" id="orthanc_config_menu" icon="orthanc"/>

        <record model="ir.action.act_window" id="act_orthanc_server_view">
            <field name="name">Servers</field>
            <field name="res_model">gnuhealth.orthanc.configServer</field>
        </record>

        <menuitem name="Servers" sequence="20" parent="orthanc_config_menu" action="act_orthanc_server_view" id="orthanc_server_menu" icon="gnuhealth-list"/>
           
        <!-- Wizard and Views to add server -->
        <record model="ir.ui.view" id="view_orthanc_add_initData">
            <field name="model">gnuhealth.orthanc.add.initData</field>
            <field name="type">form</field>
            <field name="name">add_orthanc_server_initData</field>
        </record>

        <record model="ir.ui.view" id="view_orthanc_add_status">
            <field name="model">gnuhealth.orthanc.add.status</field>
            <field name="type">form</field>
            <field name="name">add_orthanc_server_status</field>
        </record>
        
        <record model="ir.action.wizard" id="orthanc_add_server_initData">
            <field name="name">Add Orthanc Server</field>
            <field name="wiz_name">gnuhealth.orthanc.wizard.newConnect</field>
        </record>
        <menuitem parent="orthanc_config_menu" action="orthanc_add_server_initData" id="orthanc_add_server_menu" sequence="10" icon="gnuhealth-execute"/>
    </data>
</tryton>